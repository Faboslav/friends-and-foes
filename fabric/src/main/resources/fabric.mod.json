			"com.faboslav.friendsandfoes.fabric.FriendsAndFoesFabricClient"
		],
		"preLaunch": [
			"com.llamalad7.mixinextras.MixinExtrasBootstrap::init"
		],
		"modmenu": [
			"com.faboslav.friendsandfoes.fabric.modcompat.ModMenuCompat"
		],
